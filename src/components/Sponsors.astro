---
import { ArrowUpRight, Heart } from '@lucide/astro';
import data from '../data/sponsors.json';
import { text, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const sponsors: {
  login: string;
  name: string;
  avatarUrl: string;
  websiteUrl: string | null;
}[] = data;
---

<section class="sponsors" aria-labelledby="sponsors-title">
  <div class="sponsors-intro">
    <p class="mono sponsors-eyebrow">SPONSORS</p>
    <h2 id="sponsors-title">
      {locale === 'zh' ? <>因为有你<span>。</span></> : <>Supported <br />by you<span>.</span></>}
    </h2>
    <p class="sponsors-description">
      {text(
        locale,
        '感谢支持我持续投入开源的每一位朋友。',
        'Thank you to the people supporting my open-source work.',
      )}
    </p>
    <a
      class="sponsor-action"
      href="https://github.com/sponsors/medz"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Heart aria-hidden="true" />
      {text(locale, '成为赞助者', 'Become a sponsor')}
      <ArrowUpRight aria-hidden="true" />
    </a>
  </div>
  {sponsors.length ? (
    <ul class="sponsor-list">
      {sponsors.map((sponsor) => {
        const profile = `https://github.com/${sponsor.login}`;
        return (
          <li class="sponsor">
            <a
              class="sponsor-avatar"
              href={profile}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${sponsor.name} · GitHub`}
            >
              <img
                src={sponsor.avatarUrl}
                alt=""
                width="52"
                height="52"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="sponsor-details">
              <a class="sponsor-name" href={profile} target="_blank" rel="noopener noreferrer">
                {sponsor.name}
              </a>
              <span class="mono sponsor-handle">@{sponsor.login}</span>
              <div class="sponsor-links">
                <a href={profile} target="_blank" rel="noopener noreferrer">
                  GitHub<ArrowUpRight aria-hidden="true" />
                </a>
                {sponsor.websiteUrl && (
                  <a href={sponsor.websiteUrl} target="_blank" rel="noopener noreferrer">
                    {text(locale, '个人网站', 'Website')}<ArrowUpRight aria-hidden="true" />
                  </a>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="sponsors-empty">
      {text(locale, '你的支持，让更多开源想法成为现实。', 'Your support helps me keep building open-source tools.')}
    </p>
  )}
</section>

<style>
  .sponsors {
    grid-area: sponsors;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(36px, 6cqi, 112px);
    margin-top: 64px;
  }
  .sponsors-eyebrow {
    color: var(--subtle);
    letter-spacing: 0.13em;
  }
  .sponsors h2 {
    margin-top: 20px;
    font-size: clamp(36px, 4cqi, 52px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.045em;
  }
  .sponsors h2 span { color: var(--display-muted); }
  .sponsors-description {
    max-width: 28ch;
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  .sponsor-action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 13px;
    margin-top: 25px;
    border: 1px solid var(--line);
    border-radius: 5px;
    font-size: 12px;
  }
  .sponsor-action:hover {
    border-color: var(--muted);
    background: var(--soft);
  }
  .sponsor-action svg { width: 14px; height: 14px; }
  .sponsor-list {
    min-width: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .sponsor {
    display: flex;
    align-items: flex-start;
    gap: 17px;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .sponsor:first-child { border-top: 1px solid var(--line); }
  .sponsor-avatar { display: flex; flex-shrink: 0; }
  .sponsor-avatar img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--soft);
  }
  .sponsor-details { min-width: 0; }
  .sponsor-name {
    display: block;
    width: fit-content;
    max-width: 100%;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.25px;
    overflow-wrap: anywhere;
  }
  .sponsor-name:hover { text-decoration: underline; text-underline-offset: 4px; }
  .sponsor-handle {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .sponsor-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 12px;
    color: var(--muted);
  }
  .sponsor-links a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    min-height: 26px;
    font-size: 12px;
  }
  .sponsor-links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .sponsor-links svg { width: 12px; height: 12px; }
  .sponsors-empty { color: var(--muted); }
  @container site (min-width: 960px) {
    .sponsors { margin-top: 0; }
  }
  @container site (max-width: 620px) {
    .sponsors {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      margin-top: 48px;
    }
    .sponsors h2 { font-size: clamp(29px, 6cqi, 36px); }
    .sponsors h2 br { display: none; }
    .sponsors-description { max-width: 38ch; margin-top: 12px; }
    .sponsor-action { margin-top: 18px; }
    .sponsor { padding: 20px 0; }
  }
  @media (pointer: coarse) {
    .sponsor-links a, .sponsor-action { min-height: 44px; }
  }
</style>
