---
import { ArrowUpRight, Printer } from '@lucide/astro';
import { resume } from '../../data/resume';
import { site, text, type Locale } from '../../data/site';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<main id="main" class="resume">
  <div class="resume-topline">
    <span class="mono">{text(locale, '个人简历', 'RÉSUMÉ')}</span>
    <button class="text-link" type="button" data-print-resume>
      <Printer aria-hidden="true" />
      {text(locale, '打印 / 保存 PDF', 'Print / Save PDF')}
    </button>
  </div>
  <div class="resume-layout">
    <header class="resume-heading">
      <img
        class="resume-portrait"
        src="https://avatars.githubusercontent.com/u/5564821?s=256&v=4"
        alt="Seven Du"
        width="112"
        height="112"
        decoding="async"
      />
      <div class="resume-identity">
        <h1>Seven Du<span>.</span></h1>
        <p>{text(locale, '全栈工程师 · 开源创业者', 'Full-stack Engineer · Open-source Founder')}</p>
        <p class="resume-location">{text(locale, '中国 · 成都', 'Chengdu, China')}</p>
      </div>
      <div class="resume-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.url}>medz.dev</a>
        <a href={site.github}>github.com/medz</a>
      </div>
    </header>
    <div class="resume-body">
      <section class="resume-section">
        <h2>{text(locale, '个人简介', 'Profile')}</h2>
        <div class="resume-section-content">
          <p class="resume-intro">{resume.summary[locale]}</p>
        </div>
      </section>
      <section class="resume-section">
        <h2>{text(locale, '工作经历', 'Experience')}</h2>
        <div class="resume-section-content">
          {resume.experience.map((job) => (
            <article class="resume-entry">
              <div class="resume-entry-heading">
                <h3>{job.url ? <a href={job.url}>{job.organization}</a> : job.organization}</h3>
                <span class="resume-period mono">{job.start} - {job.end ?? text(locale, '至今', 'Present')}</span>
              </div>
              <p class="resume-role">{job.role[locale]}</p>
              <ul>{job.highlights[locale].map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>
      <section class="resume-section">
        <h2>{text(locale, '技术能力', 'Technical skills')}</h2>
        <dl class="resume-section-content resume-skills">
          {resume.skills.map((skill) => (
            <div>
              <dt>{skill.label[locale]}</dt>
              <dd>{skill.value}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="resume-section resume-projects">
        <h2>{text(locale, '代表项目', 'Selected work')}</h2>
        <div class="resume-section-content">
          {resume.projects.map((project) => (
            <article class="resume-entry">
              <div class="resume-entry-heading">
                <h3><a href={project.url}>{project.name}<ArrowUpRight aria-hidden="true" /></a></h3>
              </div>
              <p class="resume-role">{project.category[locale]}</p>
              <p class="resume-description">{project.description[locale]}</p>
              <ul>{project.highlights[locale].map((item) => <li>{item}</li>)}</ul>
              <a class="resume-source" href={project.url}>{project.url.replace('https://', '')}</a>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</main>

<script>
  document.querySelector('[data-print-resume]')?.addEventListener('click', () => window.print());
</script>
